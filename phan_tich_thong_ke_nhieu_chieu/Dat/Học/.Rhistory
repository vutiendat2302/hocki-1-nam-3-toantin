library(mnormt)
# Bài 1:
# Sử dụng câu lệnh set.seed(100) và sinh mẫu ngẫu nhiên gồm 100 quan sát tuân theo
#phân phối chuẩn 3 chiều với giá trị trung bình (0,0,1)′ và ma trận hiệp phương sai
library(mnormt)
set.seed(100)
n = 100
m = c(0, 0, 1)
s = c(1, .8, .6, .8, 1, .8, .6, .8, 1)
sigma = matrix(s, nrow = 3, byrow = T)
View(sigma)
# Sinh mẫu ngẫu nhiên theo pp chuẩn:
# C1: dùng mvrnorm của MASS
library(MASS)
matrix1 = mvrnorm(n = n, mu = m, Sigma = sigma)
head(matrix1)
# C2: dùng gói mvtnorm
library(mvtnorm)
matrix2 = rmvnorm(n = n, mean = m, sigma = sigma)
head(matrix2)
# C3: dùng gói nrnorm
library(RcppArmadillo)
matrix3 = rmnorm(n = n, mean = m, sigma = sigma)
# C3: dùng gói nrnorm
library(mnormt)
matrix3 = rmnorm(n = n, mean = m, varcov = sigma)
head(matrix3)
data_d = rnorm(n = n, mean = 0.5, sd = 0.5)
(data_d = rnorm(n = n, mean = 0.5, sd = 0.5))
df = data.frame(A = matrix1[, 1], B = matrix1[, 2], C = matrix1[ , 3], D = data_d)
View(df)
attach(df)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 16, col = "blue", xaxt = "n", yaxt = "n")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 1)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 10)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.5)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.8)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.8,, panel = panel.smooth)
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.8,, panel = panel.smooth, col.smooth = "red")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.8, panel = panel.smooth, col.smooth = "orange")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
pairs(df, main = "Biểu đồ phân tán các biến A, B, C, D", pch = 19, col = "blue", xaxt = "n", yaxt = "n", cex = 0.8, panel = panel.smooth, col = col.smooth = "orange")
#c.  Vẽ biểu đồ phân tán của các biến và biểu đồ nhiệt của ma trận tương quan mẫu.
