#3. Có sự khác biệt giữa lợi nhuận trung bình một ngày trước và ba ngày trước ngày đang xét không?
# Lợi nhuận trung bình 1 ngày trước
(mean_lag1 = mean(Lag1))
# Lợi nhuận trung bình 3 ngày trước
(mean_lag3 = mean(Lag3))
#3. Có sự khác biệt giữa lợi nhuận trung bình một ngày trước và ba ngày trước ngày đang xét không?
# Lợi nhuận trung bình 1 ngày trước
# Kiểm tra lag1 có tuân theo pp chuẩn không
# Bài toán:
# H0: lag1 tuân theo pp chuẩn
# H1: lag1 không tuân theo phân phối chuẩn
shapiro.test(Lag1)
# Bài toán:
# H0: lag3 tuân theo pp chuẩn
# H1: lag3 không tuân theo phân phối chuẩn
shapiro.test(Lag3)
# Bài toán:
# H0: Ex1 = Ex2
# H1: Ex1 != Ex2
# Ex1: là giá trị trung bình của lag1, Ex2: là giá trị trung bình của lag3
# Do Lag1 và Lag3 không tuân theo phân phối chuẩn -> Willcox.text
willcox.test(Lag1, Lag3, paird = T)
# Bài toán:
# H0: Ex1 = Ex2
# H1: Ex1 != Ex2
# Ex1: là giá trị trung bình của lag1, Ex2: là giá trị trung bình của lag3
# Do Lag1 và Lag3 không tuân theo phân phối chuẩn -> Wilcox.text
wilcox.test(Lag1, Lag3, paird = T)
