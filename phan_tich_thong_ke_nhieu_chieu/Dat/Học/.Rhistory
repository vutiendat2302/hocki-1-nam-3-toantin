?mtcars
model = lm(mpg ~ wt + cyl + hp, data = mtcars)
# Xây dựng mô hình hồi quy tuyến tính bội của mpg theo wt + cyl + hp.
(s = summary(model))
#1. Đưa ra phương trình hồi quy tuyến tính biểu diễn mpg theo các biến wt, cyl, và hp.
# mpg = 38.75179 - 3.16697* wt - 0.94162 * cyl - 0.01804 * hp
#2. Các biến độc lập có ý nghĩa trong việc giải thích mpg không?
# Xét mô hình: mpg = a0 + a1 * wt + a2 * cyl + a3 * hp
# Bài toán: a_i = 0 với H1: a_i != 0 (i = 1,2,3)
# Nếu Pr(|t|) = p-value thì bác bỏ H0.
# Có thể nói biến độc lập tương ứng có ý nghĩa trong viejc giải thích mpg
# Dựa vào kết quả của summary(model), thấy chỉ có biến wt có ý nghĩa ...
#3. Điều kiện về phần dư có thỏa mẫn không ?
e = model$residuals
shapiro.test(e)
#H0: Phần dư tuân theo pp chuẩn với H1: phần dư không tuân theo phân phối chuẩn
# Do p-value = 0.0525 > 0.05 nên chưa đủ cơ sở để bác bỏ H0.
# Có thể nói phần dư tuân theo phân phối chuẩn
t.test(e) #H0: E(e) = 0 với H1: E(e) != 0
# Do p-value = 1> 0.05 nên chưa đủ cơ sở để bác bỏ H0.
# Với myn 5%, có thể nói gttb của phần dư bằng 0.
# Vậy điều kiện được thỏa mãn
#4. Tìm KTC 99% cho các hệ số trong mô hình
confint(model, level = 0.99)
#5. Dự đoán giá trị của mpg theo mô hình với wt = 2.890, cyl = 6, hp = 100.
attach(mtcars)
predict(model, newdata = data.frame(wt = 2.89, cyl = 6, hp = 100))
#6. Tìm khoảng dự đoán 95% cho mpg theo mmoo hình với wt = 2.890, cyl = 6 và hp = 100
? predict
predict(model, newdata = data.frame(wt = 2.89, cyl = 6, hp = 100), interval = "prediction", level = 0.95)
# interval = "prediction" : khoảng dự đoán, "confidence": khoảng tin cậy,
# II. Lựa chọn mô hình phù hợp
#1. Hai mô hình lồng nhau:
mod = lm(mpg ~ cyl, data = mtcars)
mod1 = lm(mpg ~ cyl + disp, data = mtcars)
mod2 = lm(mpg~cyl + disp + hp, data = mtcars)
summary(mod1)
anova(mod, mod1) #H1: Sự thêm biến có ý nghĩa (Mod 1 phù hợp hơn mod)
anova(mod1, mod2)
#2. So sánh chỉ số AIC và BIC của các mô hình,có thể thông qua hàm step()
#sử dụng trực tiếp các hàm AIC() và BIC() để tính ra giátrị chỉ số trực tiếp (Dùng khi có mô hình cụ thể)
# để so sánh các mô hình
# Giá trị AIC, BIC càng nhỏ thì mô hình càng phù hợp.
AIC(mod); AIC(mod1); AIC(mod2)
BIC(mod); BIC(mod1); BIC(mod2)
# Sử dụng thêm hàm step để tìm ra mô hình phù hợp nhất theo tiêu chuẩn AIC, BIC
# Trong các mô hình 1 biến,2 biến, ..., m biến
# stepwise: forwar(thêm biến), backward(bớt biến), both(thêm và bớt biến):
# tìm ra mô hình có chỉ số AIC nhỏ nhất
# hàm step(): giá trị của k = 2, ứng với chỉ số AIC ban đầu.
# nếu thay k = log(n) ta sẽ được chỉ số của BIC
lm(mpg ~ 1, data = mtcars)
lm (mpg ~ cyl, data = mtcars)
lm (mpg ~ cyl + disp, data = mtcars)
lm (mpg ~ ., data = mtcars) # Mô hình đầy đủ
# Tìm mô hình HQTT phù hợp nhất dựa và tiêu chuẩn AIC
#step(): mpg theo 10 biến còn lại trong data mtcars
# Hướng (method): forward, backward, both
#a. forward: xuất phát từ mô hình đầu tiên(mô hình đơn giản nhất),
# ví dụ: xét Y = a0 + e (0)
# -> Thu được 1 giá trị AIC
# -> Thêm 1 trong 10 biến vào mô hình (0): Y = a0 + a*xi + e(i = 1,2,..., 10)
# -> Thu được 10 mô hình đơn biến dạng Y = a0 + ai*xi + e
# -> Chọn mô hình mà có tiêu chuẩn AIC nhỏ nhất, ví dụ là Y = a0 + a1*x1 + e(1)
# Thêm 1 trong 9 biến còn lại vào mô hình 1: Y = a0 + a1 * x1 + aj * xj + e
# Thu được 9 mô hình có dạng Y = a0 + a1 * x1 + a2 * x2 + e
# Chọn mô hình có tiêu chuẩn AIC nhỏ nhất, vid dụ là:
# Y = a0 + a1 * x1 + a2 * x2 + e(2)
# Tiếp tục đến khi thu được mô hình Y = a0 + a1*x1 +... + am*xm + e(m)
# Khi thêm bất kỳ một biến nào vào mô hình (m) mà giá trị AIC thu được
# đều lớn hơn giá trị AIC của mô hình (m) thì dừng lại.
# Chọn mô hình (m) là mô hình cuối cùng.
# b,c. backward, both: tương tự
# step(object, scope, scale, direction)
#object: mô hình bắt đầu: only/all/one/two/...
# scope: fomula(all) / fomula(mô hình phức tạp nhất)
# scale: lượng thoogn tin mong muốn được đưa ra: scale = 0
# direction = c("forward", "backward", "both")
only = lm(mpg ~ 1, data = mtcars); all = lm(mpg ~ ., data = mtcars)
fw = step(only, formula(all), direction = "forward") # giải thích từng bước
fw$anova # Các biến được chọn thêm vào mô hình so với mô hình only
summary(fw) # Tóm tắt kết quả mô hình được chọn
# từ mô hình ban đầu Y = a0 + e có AIC = 115.9
# thêm 1 trong 10 biến vào mô hình thu được 10 mô hình hồi quy tt đơn
# AIC tại mô hình chứa biến wt là nhỏ nhất và bằng 73.2
# Chọn mô hình: mgp = a0 + a1 * wt + e
# Thêm 1 trong 9 biến còn lại thu được mô hình dạng mpg = a0 + a1 * wt + a2 * xi2
# AIC min = 63.2 đặt tại cyl,, mô hình mpg = a0 + a1 *wt + a2 * cyl + e
# Thêm 1 trong 8 biến còn lại thu được mô hình dạng mpg  = a0 + a1 * wt + a2 * cyl + a3 * xi3
# AIC min = 62.7 đạt tại mô hình mpg = a0 + a1 *wt + a2 * cyl + a3 * hp + e
# Dừng lai khi việc thêm 1 biến trong các lần sau không làm giảm AIC
summary(fw)
two =lm(mpg ~ cyl + disp, data= mtcars) # mô hình bắt đầu
fw = step(two, formula(all), direction = "forward", trace = 0)
# Xem xét mô hình đơn giản nhất là mô hình two
# mpg = cyl + disp. thêm dần các biến vào mô hình two
fw$anova
summary(fw)
#1. Tìm mô hình HQTT phù hợp nhất theo hướng backward
# với mô hình ban đầu object là all hoặc five với
# five = lm (mpg ~ cyl + disp + hp + drat + wt)
five = lm (mpg ~ cyl + disp + hp + drat + wt, data=mtcars)
fw = step(five, formula(all), direction = "backward")
summary(fw)
#2. Tìm mô hình HQTT phù hợp nhất theo cả 2 hướng both
# Với mô hình ban đầu object là only/all/three
# Với three = lm(mpg~cyl + disp + hp)
three = lm(mpg~cyl + disp + hp, data = mtcars)
both = step(three, formula(all), direction = "both")
summary(both)
# Bài 2:
library(ISLR)
data("Credit")
View(Credit)
#1. Biến Limit có tương quan tuyến tính với những biến nào?
Credit = Credit[, -c(1, 8, 9, 10, 11)]
sapply(colnames(Credit), function(x) {
cor.test(Credit$Limit, Credit[[x]])
})
# Bài toán:
# H0: ri = 0 (Chưa có sự tương quan tuyến tính)
# H1: ri != 0 (Có sự tương quan tuyến tính)
# KL: Limit có tương quan tuyến tính với Income, Rating, Age do p-value < 0.05
#2.  Giải thuật từng bước "step backward" để tìm mô hình biểu diễn Limit theo các biến còn lại phù hợp nhất theo tiêu chuẩn AIC. Tìm ước lượng và khoảng tin cậy 95% của các hệ số trong mô hình thu được
all = lm(Limit ~ ., data = Credit)
bw = step(all, formula(all), direction = "backward")
bw$anova
summary(bw)
#- Mô hình ban đầu gồm tất cả các biến giải thích (ID, Income, Rating, Cards, Age, Education)
#AIC = 4035.11
#Khi loại Age: AIC giảm từ 4035.11 → 4033.1
#RSS giảm nhẹ → mô hình tốt hơn
#Vậy Age bị loại
#Loại ID → AIC giảm tiếp → loại
#Loại Income → AIC giảm → loại
#Loại Education → AIC giảm nhẹ
#Nhưng sau khi loại, mô hình tối ưu dừng lại ở:
#AIC = 4029.0
#Không thể loại thêm biến nào nữa mà AIC giảm
#- Tìm ước lượng và khoảng tin cậy 95% của các hệ số trong ô hình thu dược
confint(bw, level = 0.95)
#3. Các biến giải thích được chọn có tác động như thế nào đến giới hạn thẻ tín dụng?
# Bài toán:
#H0: ai = 0 (ko có ý nghĩa thống kê)
#H1: ai != 0  (có ý nghĩa thống kê)
# #Biến Rating, Cards có ý nghĩa thống kê với biến Limit
#4. Tìm hệ số xác định của mô hình. Giải thích ý nghĩa
#5.  Tìm khoảng dự đoán 90% cho giới hạn thẻ tín dụng của một khách hàng 30 tuổi, học 12 năm, có thu nhập 60 nghìn USD, xếp hạng tín dụng 300 và có 5 thẻ tín dụng
all = Credit[, -7]
View(all)
predict(all, newdata = data.frame(Age = 30, Income = 60000, Education = 12, Cards = 5, Rating = 300), interval = "prediction", level = 0.9)
# Bài 2:
library(ISLR)
data("Credit")
View(Credit)
#1. Biến Limit có tương quan tuyến tính với những biến nào?
Credit = Credit[, -c(1, 8, 9, 10, 11)]
sapply(colnames(Credit), function(x) {
cor.test(Credit$Limit, Credit[[x]])
})
# Bài toán:
# H0: ri = 0 (Chưa có sự tương quan tuyến tính)
# H1: ri != 0 (Có sự tương quan tuyến tính)
# KL: Limit có tương quan tuyến tính với Income, Rating, Age do p-value < 0.05
#2.  Giải thuật từng bước "step backward" để tìm mô hình biểu diễn Limit theo các biến còn lại phù hợp nhất theo tiêu chuẩn AIC. Tìm ước lượng và khoảng tin cậy 95% của các hệ số trong mô hình thu được
all = lm(Limit ~ ., data = Credit)
bw = step(all, formula(all), direction = "backward")
bw$anova
summary(bw)
#- Mô hình ban đầu gồm tất cả các biến giải thích (ID, Income, Rating, Cards, Age, Education)
#AIC = 4035.11
#Khi loại Age: AIC giảm từ 4035.11 → 4033.1
#RSS giảm nhẹ → mô hình tốt hơn
#Vậy Age bị loại
#Loại ID → AIC giảm tiếp → loại
#Loại Income → AIC giảm → loại
#Loại Education → AIC giảm nhẹ
#Nhưng sau khi loại, mô hình tối ưu dừng lại ở:
#AIC = 4029.0
#Không thể loại thêm biến nào nữa mà AIC giảm
#- Tìm ước lượng và khoảng tin cậy 95% của các hệ số trong ô hình thu dược
confint(bw, level = 0.95)
#3. Các biến giải thích được chọn có tác động như thế nào đến giới hạn thẻ tín dụng?
# Bài toán:
#H0: ai = 0 (ko có ý nghĩa thống kê)
#H1: ai != 0  (có ý nghĩa thống kê)
# #Biến Rating, Cards có ý nghĩa thống kê với biến Limit
#4. Tìm hệ số xác định của mô hình. Giải thích ý nghĩa
#5.  Tìm khoảng dự đoán 90% cho giới hạn thẻ tín dụng của một khách hàng 30 tuổi, học 12 năm, có thu nhập 60 nghìn USD, xếp hạng tín dụng 300 và có 5 thẻ tín dụng
predict(all, newdata = data.frame(Age = 30, Income = 60000, Education = 12, Cards = 5, Rating = 300), interval = "prediction", level = 0.9)
#5.  Tìm khoảng dự đoán 90% cho giới hạn thẻ tín dụng của một khách hàng 30 tuổi, học 12 năm, có thu nhập 60 nghìn USD, xếp hạng tín dụng 300 và có 5 thẻ tín dụng
predict(all, newdata = data.frame(Age = 30, Income = 60, Education = 12, Cards = 5, Rating = 300), interval = "prediction", level = 0.9)
#5.  Tìm khoảng dự đoán 90% cho giới hạn thẻ tín dụng của một khách hàng 30 tuổi, học 12 năm, có thu nhập 60 nghìn USD, xếp hạng tín dụng 300 và có 5 thẻ tín dụng
predict(all, newdata = data.frame(Age = 30, Income = 60, Education = 12, Cards = 5, Rating = 300, balance = 300), interval = "prediction", level = 0.9)
#5.  Tìm khoảng dự đoán 90% cho giới hạn thẻ tín dụng của một khách hàng 30 tuổi, học 12 năm, có thu nhập 60 nghìn USD, xếp hạng tín dụng 300 và có 5 thẻ tín dụng
predict(all, newdata = data.frame(Age = 30, Income = 60, Education = 12, Cards = 5, Rating = 300, Balance = 300), interval = "prediction", level = 0.9)
knitr::opts_chunk$set(echo = TRUE)
library(ISLR)
data("Credit")
#1
vars <- Credit[, c("Limit","Income","Rating","Cards","Age","Education")]
cor(vars)    # ma trận tương quan
pairs(vars)  # biểu đồ phân tán nếu muốn
#2.
full_mod <- lm(Limit ~ Income + Rating + Cards + Age + Education, data = Credit)
summary(full_mod)
library(MASS)
step_mod <- stepAIC(full_mod, direction = "backward", trace = FALSE)
summary(step_mod)
confint(step_mod, level = 0.95)
#4.
summary(step_mod)$r.squared
summary(step_mod)$adj.r.squared
#5.
new_data <- data.frame(
Income = 60,
Rating = 300,
Cards = 5,
Age = 30,
Education = 12
)
predict(step_mod, newdata = new_data, interval = "prediction", level = 0.90)
#Bài 1
library(MASS)
model = lm(medv ~ ., data = Boston)
#(a)
s = summary(model)
s
# Phương trình hồi quy: medv = 36.46 - 0.108 * crim + 0.046 * zn + ... - 0.5 * lstat
# Kiểm định ý nghĩa thống kê các biến
# Ta thấy hệ số của 2 biến indus và age lớn hơn 0.05 (0.738, 0.958) nên 2 biến này không có ý nghĩa thống kê, các biến còn lại có ý nghĩa thống kê
confint(model)
e = model$residuals
shapiro.test(e)
#H0: e tuân theo pp chuẩn
#H1: Ngược lại
#Do p_value < 2.2*e^(-16) < 0.05 nên bác bỏ H0
#KL: Với mức ý nghĩa 5%, e không tuân theo pp chuẩn
t.test(e)
#H0: E(e) = 0
#H1: Ngược lại
#Do p_value = 1 > 0.05 nên chưa đủ cơ sở bác bỏ H0
#KL: Với mức ý nghĩa 5%, E(e) = 0
#=> điều kiện về phần dư không thỏa mãn
#(b)
only = lm(medv ~ 1, data = Boston)
fw = step(only, formula(model), direction = "forward")
fw$anova
summary(fw)
bw = step(model, formula(model), direction = "backward")
bw$anova
summary(bw)
#(c)
anova(fw, bw)
#H0: Việc thêm biến không có ý nghĩa
#H1: Ngược lại
#Do p_value < 0.05 nên bác bỏ H0
#Với myn 5%, việc thêm biến có ý nghĩa
#(d)
names(coef(fw))
#Biến medv biểu diễn theo lstat và rm
#(e)
e = bw$residuals
shapiro.test(e)
#H0: e tuân theo pp chuẩn
#H1: Ngược lại
#Do p_value < 2.2*e^(-16) < 0.05 nên bác bỏ H0
#KL: Với mức ý nghĩa 5%, e không tuân theo pp chuẩn
t.test(e)
#H0: E(e) = 0
#H1: Ngược lại
#Do p_value = 1 > 0.05 nên chưa đủ cơ sở bác bỏ H0
#KL: Với mức ý nghĩa 5%, E(e) = 0
#=> điều kiện về phần dư không thỏa mãn
#Bài 2
library(ISLR)
View(Credit)
Credit <- Credit[, -c(1, 8, 9, 10, 11)]
View(Credit)
#(1)
sapply(colnames(Credit), function(x) {
cor.test(Credit$Limit, Credit[[x]])
})
#Limit có tương quan tuyến tính với Income, Rating, Age
#(2)
all = lm(Limit ~ ., data = Credit)
bw = step(all, formula(all), direction = "backward")
bw$anova
summary(bw)
#Mô hình ban đầu gồm tất cả biến giải thích (ID, Income, Rating, Cards, Age, Education)
#AIC = 4035.11
#Khi loại Age: AIC giảm từ 4035.11 → 4033.1
#RSS giảm nhẹ → mô hình tốt hơn
#Vậy Age bị loại
#Loại ID → AIC giảm tiếp → loại
#Loại Income → AIC giảm → loại
#Loại Education → AIC giảm nhẹ
#Nhưng sau khi loại, mô hình tối ưu dừng lại ở:
#AIC = 4029.0
#Không thể loại thêm biến nào nữa mà AIC giảm
#(3)
#Biến Rating, Cards có ý nghĩa thống kê với biến Limit
#(5)
predict(all, newdata = data.frame(Age = 30, Income = 60000, Education = 12, Cards = 5, Rating = 5), interval = "prediction", level = 0.9)
