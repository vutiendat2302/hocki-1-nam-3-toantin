? predict
predict(model, newdata = data.frame(wt = 2.89, cyl = 6, hp = 100), interval = "confidence")
predict(model, newdata = data.frame(wt = 2.89, cyl = 6, hp = 100), interval = "confidence", level = 0.95)
prediction
